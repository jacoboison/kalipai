<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="retailer" inherit_id="l10n_mx_edi.cfdiv40">
        <xpath expr="//*[name()='cfdi:Comprobante']" position="inside">
            <cfdi:Complemento xmlns:cfdi="http://www.sat.gob.mx/cfd/4" t-if="detallista">
                <!-- <t t-set="values" t-value="(record.x_complement_retailer_data or '|').split('|')"/> -->
                <!--<t t-set="lines" t-value="record.invoice_line_ids.filtered(lambda l: l.product_id)"/> -->
                <!--<t t-set="valuespr" t-value="record._set_datos_pedrem()"/>  -->
                <detallista:detallista xmlns:detallista="http://www.sat.gob.mx/detallista" type="SimpleInvoiceType" contentVersion="1.3.1" documentStructureVersion="AMC8.1" t-att-documentStatus="detallista['documentStatus']">
                    <detallista:requestForPaymentIdentification>
                        <t t-set="document_type_dict" t-value="{'I': 'INVOICE', 'E': 'CREDIT_NOTE'}"/>
                        <detallista:entityType t-raw="document_type_dict.get(detallista['tipo_de_comprobante'])"/>
                    </detallista:requestForPaymentIdentification>
                    
                        <detallista:specialInstruction t-if="detallista['mostrar_aab']" code="AAB">
                            <detallista:text t-raw="detallista['termPago']"/>
                        
                        </detallista:specialInstruction>
                    
                    <!-- <t t-set="customs" t-value="set(lines.mapped('l10n_mx_edi_customs_number')) - {False}"/> -->
                    <detallista:specialInstruction t-if="detallista['pedimentos']" code="DUT">
                        <t t-foreach="detallista['pedimentos']" t-as="pedimento">
                            <detallista:text t-raw="pedimento"/>
                        </t>
                    </detallista:specialInstruction>
                    <detallista:specialInstruction t-if="detallista['uso_disp']" code="PUR">
                        <detallista:text t-raw="detallista['uso_cfdi']"/>
                    </detallista:specialInstruction>
                    <detallista:specialInstruction code="ZZZ">
                        <detallista:text t-raw="detallista['monto_texto']"/>
                    </detallista:specialInstruction>
                    <detallista:orderIdentification> 
                        <detallista:referenceIdentification type="ON" t-raw="detallista['no_pedido']"/>
                        <detallista:ReferenceDate t-raw="detallista['ReferenceDate']"/>
                    </detallista:orderIdentification>
                    <detallista:AdditionalInformation>
                        <!-- Any of the products is a lease -->
                        <t t-if="detallista['property_taxes']">
                            <t t-foreach="detallista['property_taxes']" t-as="property_tax">
                                <detallista:referenceIdentification type="AAE" t-raw="property_tax"/>
                            </t>
                        </t>
                        <!-- If the payment method is check -->
                        <t t-if="detallista['check_payment_method']">
                            <t t-foreach="detallista['ref_payments']" t-as="check">
                                <detallista:referenceIdentification type="CK" t-raw="check"/>
                            </t>
                        </t>
                        <!-- if the payment method is a remission -->
                        <t t-if="detallista['remision_payment_method']">
                            <t t-foreach="detallista['ref_payments']" t-as="remission">
                                <detallista:referenceIdentification type="ACE" t-raw="remission"/>
                            </t>
                        </t>
                        <!-- if this invoice refers to another one for billing merchandise -->
                        <t t-if="merchandise_uuids">
                            <t t-foreach="detallista['merchandise_uuids']" t-as="merchandise_uuid">
                                <detallista:referenceIdentification type="DQ" t-raw="merchandise_uuid"/>
                            </t>
                        </t>
                        <t t-if="detallista['partner_iv']">
                            <detallista:referenceIdentification type="IV" t-raw="detallista['record_iv']"/>
                        </t>
                        <t t-if="detallista['partner_dq']">
                            <detallista:referenceIdentification type="DQ" t-raw="detallista['record_dq']"/>
                        </t>
						<t t-if="detallista['partner_atz']">
                            <detallista:referenceIdentification type="ATZ" t-raw="detallista['record_atz']"/>
                        </t>
                        <!-- Sale order identifications -->
                        <t t-foreach="detallista['identificaciones']" t-as="identification">
                            <detallista:referenceIdentification type="ON" t-raw="identification"/>
                        </t>
                        <!-- if this invoice replaces another one -->
                        <t t-if="detallista['replaceds']">
                            <t t-foreach="detallista['replaceds']" t-as="replaced">
                                <detallista:referenceIdentification type="AWR" t-raw="replaced"/>
                            </t>
                        </t>
                    </detallista:AdditionalInformation>
                        <t t-if="detallista['show_del_note']">
                            <detallista:DeliveryNote>
                                <t t-foreach="detallista['received_folios']" t-as="received_folio">
                                    <detallista:referenceIdentification t-raw="received_folio.lstrip() or False"/>
                                </t>
                                <detallista:ReferenceDate t-raw="detallista['ReferenceDate']"/>
                            </detallista:DeliveryNote>
                        </t>
                        <detallista:buyer>
                            <!-- TODO ensure the GLN may be taken from the ref -->
                            <detallista:gln t-raw="detallista['customer']['gln']"/>
                            <detallista:contactInformation>
                                <detallista:personOrDepartmentName>
                                    <!-- TODO check if taking the name from the user makes any sense -->
                                    <detallista:text t-raw="detallista['customer']['text']"/>
                                </detallista:personOrDepartmentName>
                            </detallista:contactInformation>
                        </detallista:buyer>
                    
                        <detallista:seller>
                            <!-- TODO check if supplier.ref applies for both cases -->
                            <detallista:gln t-raw="detallista['seller']['gln']"/>
                            <t t-if="detallista['seller']['SELLER_ASSIGNED_IDENTIFIER_FOR_A_PARTY']">
                                <detallista:alternatePartyIdentification type="SELLER_ASSIGNED_IDENTIFIER_FOR_A_PARTY" t-raw="detallista['seller']['dato']"/>
                            </t>
                            <t t-if="detallista['seller']['IEPS_REFERENCE']">
                                <detallista:alternatePartyIdentification type="IEPS_REFERENCE" t-raw="detallista['seller']['dato']"/>
                            </t>
                        </detallista:seller>
                    
                    <!-- <t t-set="ship_to" t-value="record.env['res.partner'].browse(record.partner_shipping_id.id)"/> -->
                    <t t-if="detallista['show_ship_to']">
                        <detallista:shipTo t-if="detallista['show_ship_to']">
                            <detallista:gln t-raw="detallista['ship_to']['ref']"/>
                            <detallista:nameAndAddress>
                                <!-- TODO check if multiple shipping addresses may be specified -->
                                <!-- <t t-foreach="ship_to" t-as="address"> -->
                                    <detallista:name t-raw="detallista['ship_to']['ref']"/>
                                    <detallista:streetAddressOne t-raw="detallista['ship_to']['streetAddressOne']"/>
                                    <detallista:city t-raw="detallista['ship_to']['city']"/>
                                    <detallista:postalCode t-raw="detallista['ship_to']['zip']"/>
                                <!-- </t> -->
                            </detallista:nameAndAddress>
                        </detallista:shipTo>
                    </t>
                    <t t-if="issued and issued != supplier">
                        <detallista:InvoiceCreator>
                            <detallista:gln t-raw="issued.ref"/>
                            <!-- TODO check codes to ensure IA is the proper one -->
                            <detallista:alternatePartyIdentification type="IA" t-raw="issued.ref"/>
                            <detallista:nameAndAddress>
                                <detallista:name t-raw="issued.name"/>
                                <detallista:streetAddressOne t-raw="', '.join([getattr(issued, fld) for fld in ('street', 'l10n_mx_edi_colony')[:35] if getattr(issued, fld)]) or False"/>
                                <detallista:city t-raw="issued.city"/>
                                <detallista:postalCode t-raw="issued.zip"/>
                            </detallista:nameAndAddress>
                        </detallista:InvoiceCreator>
                    </t>
                    <!-- TODO Check - Here need aduana information -->
                    <t t-if="False">
                        <detallista:Customs>
                            <detallista:gln t-raw="record.name"/>
                        </detallista:Customs>
                    </t>
                    <t t-if="detallista['show_currency']">
                        <detallista:currency t-att-currencyISOCode="detallista['currency_name']">
                            <detallista:currencyFunction t-raw="detallista['invoice_name'] and 'BILLING_CURRENCY'"/>
                            <detallista:rateOfChange t-raw="detallista['rate']"/>
                        </detallista:currency>
                    </t>
                    <!-- <t t-set="pay_term" t-value="record.invoice_payment_term_id"/> -->
                    <!-- <t t-if="pay_term" t-set="pay_term_period" t-value="record.invoice_date_due - record.invoice_date"/> -->
                    <!-- <t t-set="percentage_discount" t-value="round(100*float(total_price_discount or 0.0)/float(total_price_subtotal_before_discount),record.company_id.currency_id.decimal_places)"/> -->
                    <t t-if="detallista['show_payment_method']">
                        <detallista:paymentTerms t-if="detallista['pay_term_period']" t-att-paymentTermsEvent="detallista['paymentTermsEvent']" PaymentTermsRelationTime="REFERENCE_AFTER">
                            <detallista:netPayment t-att-netPaymentTermsType="detallista['netPaymentTermsType']">
                                <detallista:paymentTimePeriod>
                                    <detallista:timePeriodDue timePeriod="DAYS">
                                        <detallista:value t-raw="detallista['pay_term_period']"/>
                                    </detallista:timePeriodDue>
                                </detallista:paymentTimePeriod>
                            </detallista:netPayment>
                            <detallista:discountPayment t-att-discountType="detallista['discountType']">
                            <detallista:percentage t-raw="detallista['discount_perc']"/>
                            </detallista:discountPayment>
                        </detallista:paymentTerms>
                    </t>
                    <detallista:shipmentDetail/>
                    <t t-if="detallista['is_off_invoice']">
                        <t t-if="detallista['show_seq_number']">
                            <detallista:allowanceCharge allowanceChargeType="ALLOWANCE_GLOBAL" settlementType="OFF_INVOICE" sequenceNumber="1">
                                <detallista:specialServicesType t-raw="detallista['specialServicesType']"/>
                                <detallista:monetaryAmountOrPercentage>
                                    <detallista:rate base="INVOICE_VALUE">
                                        <detallista:percentage t-raw="detallista['discount_perc']"/>
                                    </detallista:rate>
                                </detallista:monetaryAmountOrPercentage>
                            </detallista:allowanceCharge>
                        </t>
                        <t t-if="not detallista['show_seq_number']">
                            <detallista:allowanceCharge allowanceChargeType="ALLOWANCE_GLOBAL" settlementType="OFF_INVOICE">
                                <detallista:specialServicesType t-raw="detallista['specialServicesType']"/>
                                <detallista:monetaryAmountOrPercentage>
                                    <detallista:rate base="INVOICE_VALUE">
                                        <detallista:percentage t-raw="detallista['discount_perc']"/>
                                    </detallista:rate>
                                </detallista:monetaryAmountOrPercentage>
                            </detallista:allowanceCharge>
                        </t>
                    </t>
                    <t t-if="detallista['is_bill_black']">
                        <detallista:allowanceCharge allowanceChargeType="ALLOWANCE_GLOBAL" settlementType="BILL_BACK" sequenceNumber="1">
                            <detallista:specialServicesType t-raw="detallista['specialServicesType']"/>
                            <detallista:monetaryAmountOrPercentage>
                                <detallista:rate base="INVOICE_VALUE">
                                    <detallista:percentage t-raw="detallista['discount_perc']"/>
                                </detallista:rate>
                            </detallista:monetaryAmountOrPercentage>
                        </detallista:allowanceCharge>
                    </t>
                    <t t-set="cont" t-value="1"/>
                    <!-- <t t-set="total_neto" t-value="0"/> -->
                    <t t-foreach="detallista['lineas_det']" t-as="line">
                        <detallista:lineItem type="SimpleInvoiceLineItemType" t-att-number="cont">
                            <detallista:tradeItemIdentification>
                                <detallista:gtin t-raw="line['gtin']"/>
                            </detallista:tradeItemIdentification>
                            <detallista:alternateTradeItemIdentification t-if="line['is_product_baa']" type="BUYER_ASSIGNED" t-raw="line['ide_prod']"/>
                            <detallista:alternateTradeItemIdentification t-if="line['is_product_saa']" type="SUPPLIER_ASSIGNED" t-raw="line['ide_prod']"/>
                            <detallista:tradeItemDescriptionInformation t-att-language="line['language']">
                                <detallista:longText t-raw="line['name']"/>
                            </detallista:tradeItemDescriptionInformation>
                            <detallista:invoicedQuantity t-att-unitOfMeasure="line['uom']" t-raw="line['cant']"/>
                            <detallista:grossPrice>
                                <detallista:Amount t-raw="line['grossPrice']"/>
                            </detallista:grossPrice>
                            <detallista:netPrice>
                                <detallista:Amount t-raw="line['netPrice']"/>
                            </detallista:netPrice>
                            
                            <detallista:totalLineAmount>
                                <detallista:grossAmount>
                                    <detallista:Amount t-raw="line['grossAmount']"/>
                                </detallista:grossAmount>
                                <detallista:netAmount>
                                    <detallista:Amount t-raw="line['netAmount']"/>
                                </detallista:netAmount>
                            </detallista:totalLineAmount>
                        </detallista:lineItem>
                        <t t-set="cont" t-value="cont+1"/>
                        <!-- <t t-set="total_neto" t-value="total_neto + (line.price_unit*line.quantity)"/> -->
                    </t>
                    <detallista:totalAmount>
                        <t t-if="detallista['show_sin_desc_imp']">
                            <detallista:Amount t-raw="detallista['subtotal_desc']"/>
                        </t>
                        <t t-if="not detallista['show_sin_desc_imp']">
                            <detallista:Amount t-raw="detallista['total']"/>
                        </t>
                    </detallista:totalAmount>
                    <detallista:TotalAllowanceCharge allowanceOrChargeType="ALLOWANCE">
                        <detallista:specialServicesType t-raw="detallista['specialServicesType']"/>
                        <detallista:Amount t-raw="detallista['importe_desc']"/>
                    </detallista:TotalAllowanceCharge>
                    <t t-if="detallista['show_importe_impuestos']">
                        <detallista:TotalAllowanceCharge allowanceOrChargeType="ALLOWANCE">
                            <detallista:specialServicesType>TX</detallista:specialServicesType>
                            <detallista:Amount t-raw="detallista['importe_impuestos']"/>
                        </detallista:TotalAllowanceCharge>
                    </t>
                    <t t-if="detallista['show_importe_impuestos_neg']">
                        <detallista:TotalAllowanceCharge allowanceOrChargeType="CHARGE">
                            <detallista:specialServicesType>TX</detallista:specialServicesType>
                            <detallista:Amount t-raw="detallista['importe_impuestos_neg']"/>
                        </detallista:TotalAllowanceCharge>
                    </t>
                </detallista:detallista>
            </cfdi:Complemento>
        </xpath>
    </template>

</odoo>
